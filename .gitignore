# Credentials. The remembered profile lives in %LOCALAPPDATA%, not here, but
# ignore it anyway in case RDP_PROFILE is pointed at the project.
profile.json
.env

# Emergency stop sentinel
STOP

# Captured screens and logs.
# Deliberately NOT a blanket *.png: assets/ holds the icon source and the
# PNG generated from it, and both belong in the repo.
screenshots/
*.log

# PyInstaller output
build/
dist/
build-onedir/
dist-onedir/
# The one-folder spec is generated by build.ps1 -OneDir; autoRDP.spec is source.
autoRDP-onedir.spec

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
