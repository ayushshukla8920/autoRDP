# Copy to `.env` (which is gitignored) and fill in what you need.
# Real environment variables always override these; the file only fills gaps.

# --- Telegram alerts: fired only when all reconnect attempts fail ---
# Token from @BotFather (/newbot). Chat id: message your bot once, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read result[0].message.chat.id
RDP_TELEGRAM_TOKEN=
RDP_TELEGRAM_CHAT_ID=

# --- Reconnect / stall behaviour (optional; these are the defaults) ---
# RDP_RECONNECT_ATTEMPTS=3
# RDP_RECONNECT_DELAY=5
# RDP_STALL_TIMEOUT=45     # frozen-screen seconds before a reconnect is triggered (0 = off)

# --- Connection (optional: the GUI form / CLI prompts cover these too) ---
# RDP_HOST=192.168.1.3
# RDP_USERNAME=OS3
# RDP_PASSWORD=
# RDP_PORT=3389
# RDP_AUTH=ntlm
